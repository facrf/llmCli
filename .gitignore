# --- Ambientes & Segredos (Secrets & Environment) ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx
secrets/
credentials.json
token.json

# --- Logs e Arquivos Temporários ---
logs/
*.log
